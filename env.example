# Copiez ce fichier en ".env" (ou saisissez ces valeurs dans l'hébergeur). Ne le publiez jamais.
# Clé que les téléphones des conducteurs envoient (16 caractères minimum). Générer : openssl rand -hex 24
DRIVER_KEY=
# Comptes de l'entité de contrôle : identifiant:motdepasse (8 caractères minimum), séparés par des virgules
VIEWER_USERS=controle:CHANGEZ-MOI-12345
# Derrière un proxy HTTPS (Render, Caddy, nginx) : 1
TRUST_PROXY=1
FORCE_HTTPS=1
# Stockage sur disque (optionnel) : positions conservées après redémarrage
# DATA_DIR=/data
# KEEP_HISTORY=1
# Contact transmis à la source des tuiles de carte (obligation OSM)
TILE_CONTACT=
